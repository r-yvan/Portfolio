# ── Admin portal (/admin) ─────────────────────────────────────────────
# Your password. Use a long passphrase.
ADMIN_PASSWORD=
# Random 32+ character string — signs sessions and encrypts inbox messages.
# Generate one with:  openssl rand -base64 32
ADMIN_SECRET=

# ── Storage (production) ──────────────────────────────────────────────
# Added automatically when you connect a Vercel Blob store to the project.
# Without it, deployed sites are read-only (local dev writes to content/).
BLOB_READ_WRITE_TOKEN=

# ── Optional ──────────────────────────────────────────────────────────
# Higher GitHub API limits for "Import from GitHub".
GITHUB_TOKEN=
# Only if you capture more than ~50 screenshots/day via Microlink.
MICROLINK_API_KEY=
# Canonical site URL used in metadata.
NEXT_PUBLIC_SITE_URL=https://r-yvan.vercel.app
